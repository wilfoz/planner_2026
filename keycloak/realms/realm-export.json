      "lastName": "Manager",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Manager@2024!",
          "temporary": false
        }
      ],
      "realmRoles": ["MANAGER"],
      "attributes": {
        "employee_id": ["EMP-002"],
        "department": ["Operations"],
