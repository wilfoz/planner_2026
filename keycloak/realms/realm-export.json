      "credentials": [
        {
          "type": "password",
          "value": "User@2024!",
          "temporary": false
        }
      ],
      "realmRoles": ["USER"],
      "attributes": {
        "employee_id": ["EMP-003"],
        "department": ["Field"],
        "assigned_works": ["WORK-001"],
        "manager_id": ["EMP-002"]
      }
    }
  ]
}
