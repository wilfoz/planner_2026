{
  "realm": "lt-budget-realm",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrador com controle total do sistema",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "level": ["3"],
          "permissions": [
            "work:*",
            "tower:*",
            "task:*",
            "equipment:*",
            "production:*",
            "employee:*",
            "foundation:*",
            "team:*",
            "map:*",
            "report:*",
            "system:*"
          ]
        }
      },
      {
        "name": "MANAGER",
        "description": "Gerente com CRUD completo exceto WORK",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "level": ["2"],
          "permissions": [
            "work:read",
            "tower:*",
            "task:*",
            "equipment:*",
            "production:*",
            "employee:*",
            "foundation:*",
            "team:*",
            "map:view",
            "map:configure",
            "report:view",
            "report:configure"
          ]
        }
      },
      {
        "name": "USER",
        "description": "Usuário operacional com permissões limitadas em WORK",
        "composite": false,
        "clientRole": false,
        "attributes": {
          "level": ["1"],
          "permissions": [
            "work:read",
            "work:update:status",
            "tower:*",
            "task:*",
            "equipment:*",
            "production:*",
            "employee:*",
            "foundation:*",
            "team:*",
            "map:view",
            "map:configure",
            "report:view",
            "report:configure"
          ]
        }
      }
    ]
  },

  "clients": [
    {
      "clientId": "lt-budget-angular",
      "name": "LT Budget Frontend",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:4200/*",
        "https://ltbudget.company.com/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:3000",
        "https://ltbudget.company.com"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "permissions-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "permissions",
            "claim.name": "permissions",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "assigned-works-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "assigned_works",
            "claim.name": "assigned_works",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "lt-budget-nestjs",
      "name": "LT Budget Backend",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "account",
      "name": "${client_account}",
      "rootUrl": "${authBaseUrl}",
      "baseUrl": "/realms/lt-budget-realm/account/",
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "surrogateAuthRequired": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:3000/*",
        "/realms/lt-budget-realm/account/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:3000",
        "https://ltbudget.company.com"
      ],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false
    },
    {
      "clientId": "account-console",
      "name": "${client_account-console}",
      "rootUrl": "${authBaseUrl}",
      "baseUrl": "/realms/lt-budget-realm/account/",
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "surrogateAuthRequired": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:3000/*",
        "/realms/lt-budget-realm/account/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:3000",
        "https://ltbudget.company.com"
      ],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],

  "users": [
    {
